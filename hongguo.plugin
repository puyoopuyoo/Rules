#!name=红果短剧 去广告
#!desc=屏蔽红果短剧（原番茄短剧）开屏广告、弹窗广告以及穿山甲联盟（字节跳动）广告请求。
#!author=WorkBuddy AI
#!tag=去广告

[Rule]
# 拦截字节跳动穿山甲广告 SDK
DOMAIN-SUFFIX, pangolin-sdk-toutiao.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao1.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao-b.com, REJECT
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT
DOMAIN-SUFFIX, pangle.io, REJECT

# 拦截应用内广告与日志数据上报域名
DOMAIN-SUFFIX, toblog.ctobsnssdk.com, REJECT
DOMAIN, ad.toutiao.com, REJECT
DOMAIN, mssdk-ad.toutiao.com, REJECT
DOMAIN-KEYWORD, pangolin, REJECT

[URL Rewrite]
# 拦截开屏与通用广告接口请求
^https?:\/\/.*\.snssdk\.com\/api\/ad\/ - reject
^https?:\/\/.*\.snssdk\.com\/video\/app\/ad\/ - reject
^https?:\/\/.*\.zjbyte\.cn\/api\/ad\/ - reject
^https?:\/\/.*\.amemv\.com\/api\/ad\/ - reject
^https?:\/\/is\.snssdk\.com\/bds\/ - reject

[MITM]
hostname = *.snssdk.com, *.zjbyte.cn, *.amemv.com, *.pangolin-sdk-toutiao.com, *.pangle.io
